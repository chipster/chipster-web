{
  "name": "chipster-web",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:proxy": "ng serve --configuration proxy",
    "build": "ng build --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true",
    "prettier": "npx prettier --check \"src/**/*.{ts,js,mjs,mts,html,less,css,scss}\" \"e2e/**/*.{ts,js,mjs,html}\" \"*.{ts,mjs,mts}\"",
    "prettier-write": "npx prettier --write \"src/**/*.{ts,js,mjs,mts,html,less,css,scss}\" \"e2e/**/*.{ts,js,mjs,html}\" \"*.{ts,mjs,mts}\"",
    "lint": "npx eslint src/ e2e/ playwright.config.ts vitest.config.mts eslint.config.mjs proxy.conf.mjs",
    "lint-fix": "npx eslint --fix src/ e2e/ playwright.config.ts vitest.config.mts eslint.config.mjs proxy.conf.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,mts,html,less,css,scss}": "prettier --check",
    "*.{ts,mts,js,mjs,html}": "eslint --no-warn-ignored"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/localize": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@flowjs/flow.js": "^2.13.1",
    "@fortawesome/fontawesome-free": "^6.1.1",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ng-select/ng-select": "^20.7.0",
    "@ngrx/store": "^20.1.0",
    "ag-grid-angular": "35.3.1",
    "ag-grid-community": "35.3.1",
    "angular-split": "^20.0.0",
    "bootstrap": "^5.3.0",
    "chipster-js-common": "^1.5.11",
    "d3": "^7",
    "d3-context-menu": "^2.1.0",
    "file-saver": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.8.0",
    "pako": "^2.0.3",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "^7",
    "stacktrace-js": "^2.0.0",
    "tslib": "^2.3.0",
    "uuid": "^10.0.0",
    "yaml": "^2.8.3",
    "zone.js": "~0.15.1"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@angular/language-service": "^20.3.34",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@types/d3": "^7",
    "@types/file-saver": "^2.0.5",
    "@types/flowjs": "^2.13.8",
    "@types/handsontable": "^0.24.20",
    "@types/jquery": "^3.5.13",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/pako": "^2.0.3",
    "@types/pdf": "0.0.31",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "less": "^4.2.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "$vitest"
    }
  }
}
