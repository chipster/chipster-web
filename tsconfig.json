{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "es2020",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "importHelpers": true,
    "typeRoots": ["node_modules/@types"],
    // TypeScript 6 turns strict on by default, and the code isn't strict yet
    "strict": false,
    // Handsontable is used as a global, not imported. TypeScript 6 doesn't load
    // anything from node_modules/@types by default. Node is for the e2e tests and
    // playwright.config.ts, which run in Node. The app and the unit tests leave it
    // out, see tsconfig.app.json and tsconfig.spec.json
    "types": ["handsontable", "node"]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  }
}
