{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "es2020",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "importHelpers": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2020",
      "dom"
    ],
    "useDefineForClassFields": false,
    // the type declarations of pdfjs-dist need TypeScript 5.7 or later
    "skipLibCheck": true,
    // TypeScript 6 turns strict on by default, and the code isn't strict yet
    "strict": false,
    // Handsontable is used as a global, not imported. TypeScript 6 doesn't load
    // anything from node_modules/@types by default
    "types": ["handsontable"]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  }
}
